# Generate with:  openssl rand -hex 32
STARMAP_SECRET_KEY=generate-a-long-random-string-here
STARMAP_ADMIN_PASSWORD=your-admin-password
STARMAP_ADMIN2_PASSWORD=your-secondary-admin-password
FLASK_ENV=development
FLASK_DEBUG=false
PORT=8080

# Host port Docker publishes the app on (change if 8080 is taken on the host)
STARMAP_PORT=8080
